# Dirección del host de la base de datos (usualmente 'db' en Docker)
DATABASE_HOST=XXX

# Puerto de conexión a la base de datos (PostgreSQL usa 5432 por defecto)
DATABASE_PORT=XXX

# Usuario de la base de datos
DATABASE_USERNAME=XXX

# Contraseña del usuario de la base de datos
DATABASE_PASSWORD=XXX

# Nombre de la base de datos
DATABASE_NAME=XXX

# Clave secreta para firmar JWTs (usa al menos 256 bits)
JWT_KEY=XXX

# Credenciales de AWS IAM con permisos de subida a S3
AWS_ACCESS_KEY=XXX
AWS_SECRET_KEY=XXX
